<!-- Scroll Header (apparaît à partir de la section L'amnésie IA) -->
<header class="tf-header m-0" id="scrollHeader"
        style="position:fixed;top:0;left:0;width:100%;z-index:1000;display:none;transition:transform 0.3s ease;">
    <div class="header-inner">
        <div class="container">
            <div class="row">
                <div class="col-6 col-md-1">
                    <a href="index.html" class="logo-site logo-text">
                        {{ site.name }}<span class="text-primary">_</span>
                    </a>
                </div>
                <div class="col-7 d-none d-md-block">
                    <div class="box-navigation">
                        <ul class="nav-menu-main">
                        {% include "partials/nav-numbered.njk" %}
                        </ul>
                    </div>
                </div>
                <div class="col-3 col-md-2 d-none d-sm-block">
                    <div class="header-contact">
                        <a href="mailto:{{ site.email }}" class="link text-caption">{{ site.email | upper }}</a>
                        <p class="text-caption">
                            KOH TAO <span class="clock"></span>
                        </p>
                    </div>
                </div>
                <div class="col-6 col-sm-3 col-md-2 d-flex justify-content-end align-items-start">
                    <button type="button" class="btn-mobile-menu open-mb-menu text-caption text-white link d-md-none">
                        <i class="icon icon-menu"></i>
                        MENU
                    </button>
                    <a href="#contactScroll" class="tf-btn d-none d-md-flex">
                        <span class="text-caption">CONTACT</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var header = document.getElementById('scrollHeader');
    var trigger = document.getElementById('workScroll');
    if (!header || !trigger) return;
    window.addEventListener('scroll', function() {
        if (trigger.getBoundingClientRect().top <= 0) {
            header.style.display = '';
        } else {
            header.style.display = 'none';
        }
    }, { passive: true });
});
</script>
