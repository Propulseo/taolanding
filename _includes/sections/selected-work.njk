<!-- Le problème -->
<section class="section-selected-work-v2 flat-spacing stack-element" id="workScroll">
    <div class="s-header d-block overflow-hidden">
        <div class="infiniteSlide infiniteSlide_select_work" data-clone="5">
            {% for i in range(0, 3) %}
            <p class="text-display-1 letter-space--3 fw-semibold">
                Pourquoi tes outils ne marchent pas
            </p>
            <div class="icon-app">
                <img loading="lazy" width="120" height="120" src="assets/images/item/global.svg" alt="Image">
            </div>
            {% endfor %}
        </div>
    </div>
    <div class="container">
        <div class="work-list stack-element-main position-relative">

            <div class="element">
                <a href="#" class="wg-work effectFade fadeUp no-div">
                    <div class="work-image">
                        <video muted="" autoplay="" loop="" playsinline="">
                            <source src="assets/images/video/nexbot.mp4" type="video/mp4">
                        </video>
                    </div>
                    <div class="work-content">
                        <div class="work_top">
                            <h5 class="letter-space--2">L'amnésie IA_</h5>
                            <ul class="tf-list vertical text-end">
                                <li class="text-white-64">Le problème</li>
                                <li class="effectFade fadeUp">ChatGPT oublie tout</li>
                                <li class="effectFade fadeUp">à chaque conversation</li>
                            </ul>
                        </div>
                        <div class="work_bottom">
                            <ul class="tf-list vertical">
                                <li class="text-white-64">L'impact</li>
                                <li class="effectFade fadeUp">Tu recommences de zéro</li>
                                <li class="effectFade fadeUp">chaque jour</li>
                            </ul>
                            <h5 class="letter-space--2">100% des utilisateurs IA</h5>
                        </div>
                    </div>
                </a>
            </div>

            <div class="element">
                <a href="#" class="wg-work">
                    <div class="work-image">
                        <img loading="lazy" width="1296" height="648" src="assets/images/section/work-5.jpg" alt="Image">
                    </div>
                    <div class="work-content">
                        <div class="work_top">
                            <h5 class="letter-space--2">La journée qui déborde_</h5>
                            <ul class="tf-list vertical text-end">
                                <li class="text-white-64">Le problème</li>
                                <li class="effectFade fadeUp">Trop de tâches,</li>
                                <li class="effectFade fadeUp">aucune priorité claire</li>
                            </ul>
                        </div>
                        <div class="work_bottom">
                            <ul class="tf-list vertical">
                                <li class="text-white-64">L'impact</li>
                                <li class="effectFade fadeUp">15 min perdues chaque matin</li>
                                <li class="effectFade fadeUp">à décider quoi faire</li>
                            </ul>
                            <h5 class="letter-space--2">91% des professionnels</h5>
                        </div>
                    </div>
                </a>
            </div>

            <div class="element">
                <a href="#" class="wg-work">
                    <div class="work-image">
                        <img loading="lazy" width="1296" height="648" src="assets/images/section/work-6.jpg" alt="Image">
                    </div>
                    <div class="work-content">
                        <div class="work_top">
                            <h5 class="letter-space--2">Le système qui s'effondre_</h5>
                            <ul class="tf-list vertical text-end">
                                <li class="text-white-64">Le problème</li>
                                <li class="effectFade fadeUp">Notion, Todoist, Trello...</li>
                                <li class="effectFade fadeUp">trop complexes pour durer</li>
                            </ul>
                        </div>
                        <div class="work_bottom">
                            <ul class="tf-list vertical">
                                <li class="text-white-64">L'impact</li>
                                <li class="effectFade fadeUp">App abandonnée</li>
                                <li class="effectFade fadeUp">en moins de 3 semaines</li>
                            </ul>
                            <h5 class="letter-space--2">70% d'abandon</h5>
                        </div>
                    </div>
                </a>
            </div>

        </div>
        <div class="d-flex justify-content-center">
            <a href="#serviceScroll" class="tf-btn style-2">
                DÉCOUVRIR LA SOLUTION
            </a>
        </div>
    </div>
</section>
