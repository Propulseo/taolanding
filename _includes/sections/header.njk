<!-- Header -->
<header class="tf-header style-2">
    <div class="header-inner">
        <div class="container">
            <div class="row">
                <div class="col-6 col-md-1">
                    <a href="index.html" class="logo-site logo-text">
                        {{ site.name }}<span class="text-primary">_</span>
                    </a>
                </div>
                <div class="col-3 col-md-2 ms-xl-auto d-none d-md-block">
                    <ul class="tf-list vertical">
                        <li><a href="#workScroll" class="link text-caption">PROBLÈME</a></li>
                        <li><a href="#serviceScroll" class="link text-caption">FONCTIONNALITÉS</a></li>
                        <li><a href="#pricingScroll" class="link text-caption">TARIFS</a></li>
                        <li><a href="blog.html" class="link text-caption">BLOG</a></li>
                        <li><a href="#contactScroll" class="link text-caption">CONTACT</a></li>
                    </ul>
                </div>
                <div class="col-3 col-md-2 d-none d-sm-block ms-auto ms-xl-0">
                    <div class="header-contact">
                        <a href="mailto:{{ site.email }}" class="link text-caption">{{ site.email | upper }}</a>
                        <p class="text-caption text-utc">
                            <i class="icon icon-globe"></i>
                            {{ site.location | upper }}
                        </p>
                    </div>
                </div>
                <div class="col-6 col-sm-3 col-md-2 d-flex justify-content-end align-items-start d-md-none">
                    <button type="button" class="btn-mobile-menu open-mb-menu text-caption text-white link">
                        <i class="icon icon-menu"></i>
                        MENU
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>
