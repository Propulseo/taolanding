<!-- Tarifs -->
<section class="section-pricing type-2 flat-spacing flat-animate-tab" id="pricingScroll">
    <div class="s-header d-block overflow-hidden">
        <div class="infiniteSlide infiniteSlide_select_work" data-clone="5">
            {% for i in range(0, 3) %}
            <p class="text-display-1 letter-space--3 fw-semibold">Tarifs</p>
            <div class="icon-app">
                <img loading="lazy" width="120" height="120" src="assets/images/item/global.svg" alt="Image">
            </div>
            {% endfor %}
        </div>
    </div>
    <div class="container">
        <div class="tf-grid-layout md-col-2 lg-col-3">

            <!-- Free -->
            <div class="wg-plan">
                <div class="br-line"></div>
                <div class="plan-name letter-space--1 fw-medium">Free</div>
                <h4 class="plan-price">
                    0€ <span class="text-body-2 fw-normal text-white-64">pour toujours</span>
                </h4>
                <p class="plan-desc text-white-64 letter-space--1">
                    Teste Tao sans engagement. L'essentiel pour organiser ta journée.
                </p>
                <a href="#contactScroll" class="btn-action tf-btn style-2 style-troke w-100">
                    <span class="text-caption fw-medium">COMMENCER GRATUITEMENT</span>
                </a>
                <ul class="benefit-list tf-list vertical">
                    <li class="benefit_title letter-space--1 text-white-64">Inclus :</li>
                    <li><span>//</span> 5 messages par fenêtre de 4h</li>
                    <li><span>//</span> Mémoire active 30 jours</li>
                    <li><span>//</span> Check-in matin + bilan soir</li>
                    <li><span>//</span> Victoire du jour</li>
                    <li class="text-white-32">&#10005; Notifications push</li>
                    <li class="text-white-32">&#10005; 3 pierres automatiques</li>
                    <li class="text-white-32">&#10005; Intégrations agenda</li>
                </ul>
            </div>

            <!-- Pro -->
            <div class="wg-plan style-2 type-2">
                <div class="bg-img bg-img_2">
                    <img loading="lazy" width="416" height="625" src="assets/images/item/bg-6.png" alt="Image">
                </div>
                <div class="br-line bg-primary"></div>
                <div class="plan-name letter-space--1 fw-medium">Pro</div>
                <h4 class="plan-price">
                    <span><span class="text-primary">29</span>€</span>
                    <span class="text-body-2 fw-normal text-white-64">/mois · ou 249€/an · 14 jours gratuits</span>
                </h4>
                <p class="plan-desc text-white-64 letter-space--1">
                    L'expérience complète. Mémoire permanente, notifications et intégrations.
                </p>
                <a href="#contactScroll" class="btn-action tf-btn style-2 style-fill w-100 animate-btn animate-dark">
                    <span class="text-caption fw-medium">CHOISIR PRO</span>
                </a>
                <ul class="benefit-list tf-list vertical">
                    <li class="benefit_title letter-space--1 text-white-64">Tout de Free, plus :</li>
                    <li><span class="text-primary">//</span> Messages illimités</li>
                    <li><span class="text-primary">//</span> Mémoire longue permanente</li>
                    <li><span class="text-primary">//</span> Notifications 7h15 + 21h30</li>
                    <li><span class="text-primary">//</span> 3 pierres de la semaine</li>
                    <li><span class="text-primary">//</span> Revue du vendredi automatique</li>
                    <li><span class="text-primary">//</span> Sync Google Calendar</li>
                    <li><span class="text-primary">//</span> Connexion Claude AI</li>
                    <li><span class="text-primary">//</span> Historique complet 90 jours</li>
                </ul>
            </div>

            <!-- Bientôt -->
            <div class="wg-plan style-2 type-3">
                <div class="bg-img bg-img_1"></div>
                <div class="br-line bg-white"></div>
                <div class="plan-name letter-space--1 fw-medium">Bientôt</div>
                <h4 class="plan-price">
                    — <span class="text-body-2 fw-normal text-white-64">en développement</span>
                </h4>
                <p class="plan-desc text-white-64 letter-space--1">
                    Intégrations avancées et rapports personnalisés pour les power users.
                </p>
                <a href="#contactScroll" class="btn-action tf-btn style-2 style-fill-white w-100 animate-btn animate-dark">
                    <span class="text-caption fw-medium">ME PRÉVENIR</span>
                </a>
                <ul class="benefit-list tf-list vertical">
                    <li class="benefit_title letter-space--1 text-white-64">À venir :</li>
                    <li><span>//</span> Intégrations avancées</li>
                    <li><span>//</span> Rapport mensuel narratif</li>
                    <li><span>//</span> API personnalisée</li>
                    <li><span>//</span> Accès communauté privée</li>
                </ul>
            </div>

        </div>
        <p class="text-center text-white-64 letter-space--1" style="margin-top:2rem;">
            Tarifs de lancement. Les early adopters gardent ce prix à vie.
        </p>
    </div>
</section>
